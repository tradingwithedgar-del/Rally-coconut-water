# Higgsfield pay-as-you-go API credentials.
# One key pair covers BOTH the Seedance 2.5 video calls and the text-to-speech
# calls. Nothing in this pipeline is free and nothing works without it.
HF_CREDENTIALS="YOUR_KEY_ID:YOUR_KEY_SECRET"

# Or split:
# HF_API_KEY="YOUR_KEY_ID"
# HF_API_SECRET="YOUR_KEY_SECRET"

# Optional: override the font used for captions and the end card (bold TTF).
# REEL_FONT="/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf"
