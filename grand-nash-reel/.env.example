# Higgsfield pay-as-you-go API credentials.
# Create a key pair in the Higgsfield API console (the pay-as-you-go platform).
# This is NOT the MCP server and NOT your subscription credits — requests here
# bill per generation against your pay-as-you-go balance.

HF_CREDENTIALS="YOUR_KEY_ID:YOUR_KEY_SECRET"

# Equivalent alternative, if you prefer them split:
# HF_API_KEY="YOUR_KEY_ID"
# HF_API_SECRET="YOUR_KEY_SECRET"

# Optional: override the font used for burned-in text (must be a bold TTF).
# REEL_FONT="/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf"
